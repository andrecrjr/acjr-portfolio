---
import Layout from "../layouts/Layout.astro";
import PortfolioCard from "../components/PortfolioCard.astro";

// ISR Configuration - On-demand revalidation
export const prerender = false; // Enable server-side rendering

// ISR Cache Management
const CACHE_DURATION = 5 * 60 * 1000; // 5 minutes in milliseconds
const STALE_WHILE_REVALIDATE = 24 * 60 * 60 * 1000; // 24 hours in milliseconds

// Set ISR cache headers for on-demand revalidation
const cacheAge = Math.floor(CACHE_DURATION / 1000); // Convert to seconds
const staleAge = Math.floor(STALE_WHILE_REVALIDATE / 1000); // Convert to seconds

// Configure response headers for ISR
Astro.response.headers.set(
	"Cache-Control",
	`public, s-maxage=${cacheAge}, stale-while-revalidate=${staleAge}`,
);
Astro.response.headers.set("CDN-Cache-Control", `public, s-maxage=${cacheAge}`);
Astro.response.headers.set("Vary", "Accept-Encoding");

// Add timestamp for debugging
const buildTime = new Date().toISOString();
Astro.response.headers.set("X-Build-Time", buildTime);

// SEO Configuration
const seoConfig = {
	title: "Portfolio - André Carlos Junior - ACJR Hub",
	description:
		"Explore André Carlos Junior's portfolio showcasing innovative front-end development projects, modern web applications, and cutting-edge UI/UX designs. Discover expertise in React, JavaScript, TypeScript, and modern web technologies.",
	keywords:
		"André Carlos Junior, ACJR, portfolio, front-end developer, web developer, software engineer, React, JavaScript, TypeScript, web development, UI/UX design, full-stack developer",
	author: "André Carlos Junior",
	ogImage: "/og-image.jpg",
	ogType: "website",
	twitterHandle: "@acjr",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Person",
		name: "André Carlos Junior",
		jobTitle: "Front-End Software Engineer",
		url: Astro.url.toString(),
		sameAs: [
			"https://github.com/andrecrjr",
			"https://linkedin.com/in/andrecrjr",
		],
		knowsAbout: [
			"JavaScript",
			"TypeScript",
			"React",
			"Astro",
			"Node.js",
			"Front-end Development",
			"Web Development",
			"UI/UX Design",
			"Software Architecture",
		],
		description:
			"Experienced front-end software engineer specializing in modern web technologies and user experience design.",
		worksFor: {
			"@type": "Organization",
			name: "ACJR Hub",
		},
	},
};
---

<Layout {...seoConfig}>
	<PortfolioCard pageSize={10} />
</Layout>

<style>
	/* Reset default layout styles for full-screen design */
	:global(html, body) {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:global(body) {
		font-family: 'Anonymous Pro', 'Courier New', monospace;
	}

	/* Ensure the layout doesn't add extra padding */
	:global(.layout-content) {
		padding: 0;
		margin: 0;
	}
</style>