---
import Layout from "../layouts/Layout.astro";
import PortfolioCard from "../components/PortfolioCard.astro";

// ISR Configuration - On-demand revalidation
export const prerender = false; // Enable server-side rendering

// ISR Cache Management
const CACHE_DURATION = 5 * 60 * 1000; // 5 minutes in milliseconds
const STALE_WHILE_REVALIDATE = 24 * 60 * 60 * 1000; // 24 hours in milliseconds

// Set ISR cache headers for on-demand revalidation
const cacheAge = Math.floor(CACHE_DURATION / 1000); // Convert to seconds
const staleAge = Math.floor(STALE_WHILE_REVALIDATE / 1000); // Convert to seconds

// Configure response headers for ISR
Astro.response.headers.set(
	"Cache-Control",
	`public, s-maxage=${cacheAge}, stale-while-revalidate=${staleAge}`,
);
Astro.response.headers.set("CDN-Cache-Control", `public, s-maxage=${cacheAge}`);
Astro.response.headers.set("Vary", "Accept-Encoding");

// Add timestamp for debugging
const buildTime = new Date().toISOString();
Astro.response.headers.set("X-Build-Time", buildTime);

// SEO Configuration
const seoConfig = {
	title: "André Carlos Junior - Front End Engineer, Software Engineer and AI Engineer",
	description:
		"Portfolio of André Carlos Junior: Front End Engineer, React, Typescript, Software Engineer and AI Engineer.",
	keywords:
		"André Carlos Junior, ACJR, portfolio, Front End Engineer, React, Typescript, Software Engineer, AI Engineer",
	author: "André Carlos Junior",
	ogImage: "/og-image.jpg",
	ogType: "website",
	twitterHandle: "@acjr",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Person",
		name: "André Carlos Junior",
		jobTitle: "Front End Engineer, Software Engineer and AI Engineer",
		url: Astro.url.toString(),
		sameAs: [
			"https://github.com/andrecrjr",
			"https://linkedin.com/in/andrecrjr",
		],
		knowsAbout: [
			"JavaScript",
			"Typescript",
			"React",
			"Astro",
			"Node.js",
			"Front-end Development",
			"Web Development",
			"AI Engineering",
			"UI/UX Design",
			"Software Architecture",
		],
		description:
			"Front End Engineer, React, Typescript, Software Engineer and AI Engineer.",
		worksFor: {
			"@type": "Organization",
			name: "ACJR Hub",
		},
	},
};
---

<Layout {...seoConfig}>
	<PortfolioCard pageSize={10} />
</Layout>
